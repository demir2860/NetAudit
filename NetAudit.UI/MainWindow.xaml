<Window x:Class="NetAudit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetAudit Pro - Wireshark" Height="800" Width="1400"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="11">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                    <ComboBox x:Name="DeviceSelector" Width="350" Padding="6" Margin="0,0,10,0"/>
                    <Button Content="▶ Start" Padding="10,5" Background="#4CAF50" Foreground="White" Click="OnStartCapture"/>
                    <Button Content="⏹ Stop" Padding="10,5" Margin="5,0" Background="#F44336" Foreground="White" Click="OnStopCapture"/>
                    <Button Content="Clear" Padding="10,5" Background="#999" Foreground="White" Click="OnClearPackets"/>
                    <TextBlock x:Name="PacketCount" Text="Packets: 0" Margin="20,0,0,0" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="FilterBox" Width="300" Padding="6" Placeholder="Filter: dns | tcp | 192.168.1.1"/>
                    <Button Content="Filter" Padding="10,5" Margin="5,0,0,0" Background="#1976D2" Foreground="White" Click="OnApplyFilter"/>
                    <TextBlock Text="(use | for OR, e.g. dns|icmp)" Margin="10,0,0,0" Foreground="#999" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- PACKET LIST (left) -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <DataGrid x:Name="PacketGrid" AutoGenerateColumns="False" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding No}" Width="40"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/>
                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="100"/>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                    <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="60"/>
                    <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- VERTICAL SPLITTER -->
        <GridSplitter Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="#DDD" Cursor="SizeWE"/>

        <!-- PROTOCOL STATS (right, clickable) -->
        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Protocol Stats (Click to Filter)" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox x:Name="ProtocolStats" Background="Transparent" BorderThickness="0" MouseDoubleClick="OnProtocolDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="5" Background="#E8F5E9" CornerRadius="3" Margin="0,2" Cursor="Hand">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock FontWeight="Bold" Foreground="#2E7D32" Text="{Binding Protocol}"/>
                                    <TextBlock Foreground="#666" Text="{Binding CountText}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- HORIZONTAL SPLITTER -->
        <GridSplitter Grid.Row="2" Grid.Column="0" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#DDD" Cursor="SizeNS"/>

        <!-- PACKET DETAILS (bottom left) -->
        <Border Grid.Row="3" Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBox x:Name="DetailView" IsReadOnly="True" Background="White" Foreground="#333"
                     FontFamily="Courier New" FontSize="9" TextWrapping="Wrap" Padding="10"/>
        </Border>
    </Grid>
</Window>
