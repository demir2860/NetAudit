<Window x:Class="NetAudit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetAudit Pro - Quick Test | Switch Test" Height="800" Width="1400"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="11">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT MENU -->
        <StackPanel Grid.Column="0" Background="#F0F0F0" Orientation="Vertical" Margin="10">
            <TextBlock Text="NetAudit Pro" FontSize="14" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>
            <Button x:Name="BtnCapture" Content="⚡ Quick Test" Padding="10,8" Margin="0,0,0,5" Background="#1565C0" Foreground="White" FontWeight="Bold" Click="OnTabCapture"/>
            <Button x:Name="BtnNetDiag" Content="🌐 Switch Test" Padding="10,8" Margin="0,0,0,5" Background="#E0E0E0" Foreground="#333" Click="OnTabNetworkDiag"/>
        </StackPanel>

        <!-- RIGHT CONTENT (Tab Container) -->
        <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>

        <!-- CAPTURE TAB (Hidden until needed) -->
        <Grid x:Name="CaptureTabGrid" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOOLBAR -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- ROW 1: Device Selector + Buttons + Packet Count -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="DeviceSelector" Width="550" Padding="8,6" VerticalContentAlignment="Center" FontSize="11"/>
                        <Button Content="▶ Start" Padding="14,6" Margin="15,0,0,0" Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="OnStartCapture"/>
                        <Button Content="⏹ Stop" Padding="14,6" Margin="5,0" Background="#C62828" Foreground="White" FontWeight="Bold" Click="OnStopCapture"/>
                        <Button Content="🔄 Clear" Padding="14,6" Background="#F57C00" Foreground="White" FontWeight="Bold" Click="OnClearPackets"/>
                        <TextBlock x:Name="PacketCount" Text="Packets: 0" Margin="25,0,0,0" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="#1565C0"/>
                    </StackPanel>
                    <!-- ROW 2: Filter Box + Report Button -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Filter:" Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                        <TextBox x:Name="FilterBox" Width="300" Padding="8,6" VerticalContentAlignment="Center" Foreground="#333" FontSize="11"/>
                        <Button Content="🔍 Apply Filter" Padding="14,6" Margin="10,0,0,0" Background="#1565C0" Foreground="White" FontWeight="Bold" Click="OnApplyFilter"/>
                        <Button Content="📄 Generate Report" Padding="14,6" Margin="10,0,0,0" Background="#7B1FA2" Foreground="White" FontWeight="Bold" Click="OnGenerateReportFile"/>
                        <TextBlock Text="(txt/pdf)" Margin="10,0,0,0" Foreground="#666" VerticalAlignment="Center" FontSize="9"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PACKET LIST (left) -->
            <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <DataGrid x:Name="PacketGrid" AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="White" AlternatingRowBackground="#F5F5F5" RowHeight="28">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No." Binding="{Binding No}" Width="45"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/>
                        <DataGridTextColumn Header="Source IP" Binding="{Binding Source}" Width="120"/>
                        <DataGridTextColumn Header="Dest IP" Binding="{Binding Destination}" Width="120"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="75"/>
                        <DataGridTextColumn Header="Length (B)" Binding="{Binding Length}" Width="70"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Info}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- VERTICAL SPLITTER -->
            <GridSplitter Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="#DDD" Cursor="SizeWE"/>

            <!-- PROTOCOL STATS (right, clickable) -->
            <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="10">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Protocols (Double-Click)" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="ProtocolStats" Background="Transparent" BorderThickness="0" PreviewMouseDoubleClick="OnProtocolDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="5" Background="#E8F5E9" CornerRadius="3" Margin="0,2" Cursor="Hand">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock FontWeight="Bold" Foreground="#2E7D32" Text="{Binding Protocol}"/>
                                        <TextBlock Foreground="#666" Text="{Binding CountText}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- HORIZONTAL SPLITTER -->
            <GridSplitter Grid.Row="2" Grid.Column="0" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#DDD" Cursor="SizeNS"/>

            <!-- DETAILS (bottom left) -->
            <Border Grid.Row="3" Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <TextBox x:Name="DetailView" IsReadOnly="True" Background="White" Foreground="#333"
                         FontFamily="Courier New" FontSize="9" TextWrapping="Wrap" Padding="10"/>
            </Border>
        </Grid>
    </Grid>
</Window>
