<Page x:Class="NetAudit.UI.NetworkDiagPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Network Diagnostics" Background="#F5F7FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Orientation="Vertical">
            <TextBlock Text="Network Diagnostics" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

            <!-- Device Connection Form -->
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,20">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Device Connection" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1565C0"/>

                    <!-- IP Address -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Device IP" Width="120" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="TxtDeviceIP" Width="250" Padding="8,6"/>
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="SSH Port" Width="120" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="TxtPort" Width="100" Padding="8,6" Text="22"/>
                    </StackPanel>

                    <!-- Vendor -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Vendor" Width="120" VerticalAlignment="Center" FontWeight="Bold"/>
                        <ComboBox x:Name="CmbVendor" Width="200" Padding="8,6">
                            <ComboBoxItem>Cisco IOS</ComboBoxItem>
                            <ComboBoxItem>Cisco IOS-XE</ComboBoxItem>
                            <ComboBoxItem>Huawei VRP</ComboBoxItem>
                            <ComboBoxItem>Aruba OS</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Username" Width="120" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="TxtUsername" Width="250" Padding="8,6" Text="admin"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Password" Width="120" VerticalAlignment="Center" FontWeight="Bold"/>
                        <PasswordBox x:Name="TxtPassword" Width="250" Padding="8,6"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Button x:Name="BtnTestConnection" Content="✓ Test Connection" Padding="14,6" Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="OnTestConnection" Margin="0,0,10,0"/>
                        <Button x:Name="BtnRunDiagnostic" Content="▶ Run Diagnostic" Padding="14,6" Background="#1565C0" Foreground="White" FontWeight="Bold" Click="OnRunDiagnostic" IsEnabled="False" Margin="0,0,10,0"/>
                        <Button x:Name="BtnGenerateReport" Content="📄 Generate Report" Padding="14,6" Background="#7B1FA2" Foreground="White" FontWeight="Bold" Click="OnGenerateReport" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Connection Status -->
            <Border x:Name="StatusBorder" Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Connection Status" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2E7D32"/>
                    <TextBlock x:Name="StatusText" Text="" Foreground="#333"/>
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,20" Visibility="Collapsed" x:Name="ResultsBorder">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Diagnostic Results" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1565C0"/>

                    <!-- Device Info -->
                    <TextBlock x:Name="DeviceInfoText" Text="" TextWrapping="Wrap" Foreground="#333" Margin="0,0,0,15" FontSize="11" Background="#F0F0F0" Padding="8"/>

                    <!-- Analysis Results -->
                    <TextBlock Text="Log Analysis" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#666"/>
                    <ListBox x:Name="InterfacesList" Height="300" Margin="0,0,0,0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2" CornerRadius="2" Background="#F5F5F5">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Severity}" FontWeight="Bold" FontSize="10" Margin="0,0,0,3" Foreground="#D32F2F"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#333" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Error Display -->
            <Border x:Name="ErrorBorder" Background="#FFEBEE" BorderBrush="#F44336" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,20" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Text="" TextWrapping="Wrap" Foreground="#C62828"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
